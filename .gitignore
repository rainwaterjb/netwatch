# Secrets and local state: never commit these
.env
*.env
!.env.example
data/
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# TLS certificates and keys (e.g. from the Let's Encrypt guide) never go into git
certs/
*.pem
*.key

# Secrets for the optional monitoring stack
examples/monitoring/netwatch_token
examples/monitoring/*.crt
examples/monitoring/.env
