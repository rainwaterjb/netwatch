# Copy to .env and fill in. Leave a value empty to disable that feature.

# Network
# Your LAN subnet. Auto-detected from the default interface if empty, but setting it is recommended.
SUBNET=192.168.1.0/24
# Interface on the LAN (e.g. eth0, ens18, vmbr0). Auto-detected if empty.
INTERFACE=
# Seconds between scans.
SCAN_INTERVAL=60
# How many scans in a row a device can miss before it counts as offline.
# 3 x 60s = alert after ~3 minutes. Raise this if phones cause false alarms.
OFFLINE_AFTER_MISSED_SCANS=3
EVENT_RETENTION_DAYS=90
# Time zone for alert messages, e.g. America/New_York, Europe/London
TZ=UTC
# HTTPS
# self-signed (default): NetWatch creates its own certificate in /data/tls.
#   Your browser will warn the first time; install the certificate (link in the
#   dashboard header) on your devices to make the warning go away.
# custom: use your own certificate (set TLS_CERT_FILE and TLS_KEY_FILE).
# off:    plain HTTP on PORT (not recommended: the login is sent unencrypted).
TLS=self-signed
# Dashboard address: https://<host-ip>:HTTPS_PORT
HTTPS_PORT=8443
# Plain-HTTP port. Redirects to HTTPS (or serves the dashboard when TLS=off).
PORT=8080
# Extra names/IPs to put in the self-signed certificate, comma-separated
# (the host's name and LAN IP are added automatically). Example: netwatch.lan
TLS_HOSTNAMES=
# For TLS=custom: paths inside the container (mount them in docker-compose.yml)
TLS_CERT_FILE=
TLS_KEY_FILE=

# Web UI security
# Strongly recommended: set a password (HTTP Basic login). Use a long random value,
# e.g. generate one with:  openssl rand -base64 24
WEB_USERNAME=admin
WEB_PASSWORD=
# Optional: comma-separated hostnames/IPs you use to reach the UI. Requests with any
# other Host header are rejected (protects against DNS rebinding).
# Example: ALLOWED_HOSTS=192.168.1.50,netwatch.lan
ALLOWED_HOSTS=

# Phone alerts: ntfy (free app for iOS/Android; ntfy.sh or self-hosted)
# Example: https://ntfy.sh/<long-random-topic>. Anyone who knows the topic name can
# read your alerts on the public server, so make it long and random.
NTFY_URL=
NTFY_TOKEN=

# Phone alerts: Pushover (alternative or in addition to ntfy)
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# Email alerts: SMTP
# Gmail: smtp.gmail.com, 587, starttls, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated list of recipients
SMTP_TO=

# Optional: Linksys Velop / Atlas router integration
# Shows DHCP reservations and the DHCP pool on the IP map, and uses the names from
# your router as device names. Uses the router's undocumented local JNAP API.
# Leave LINKSYS_URL empty to disable.
LINKSYS_URL=
LINKSYS_USERNAME=admin
LINKSYS_PASSWORD=
# Seconds between router syncs (minimum 60)
ROUTER_POLL_INTERVAL=300
# Allow adding/removing DHCP reservations from the Reservations tab.
# Off by default. Also requires WEB_PASSWORD to be set. A backup of the router's
# LAN settings is saved to /data/router-backups before every change.
LINKSYS_ALLOW_CHANGES=false

# Internet (WAN) monitoring
# Checks your internet connection and records outages (Services tab).
WAN_CHECK=true
# Seconds between checks
WAN_CHECK_INTERVAL=30
# Public addresses to test, host:port, comma-separated. The internet counts as
# down only when none of them answer.
WAN_CHECK_TARGETS=1.1.1.1:443,8.8.8.8:443,9.9.9.9:443

# Optional: Pi-hole v6 integration (read-only)
# Shows each device's DNS query volume and top domains, and flags devices that
# suddenly make far more queries than usual. Requires Pi-hole v6 or newer.
# List one or more Pi-holes, comma-separated, e.g. http://192.168.1.2,http://192.168.1.3
PIHOLE_URLS=
# Pi-hole password, or better an app password (Pi-hole: Settings > Web interface / API).
# For several Pi-holes with different passwords, list them in the same order, comma-separated.
PIHOLE_PASSWORD=
# Set to false if your Pi-hole uses its default self-signed HTTPS certificate
PIHOLE_VERIFY_TLS=true
# Seconds between Pi-hole syncs (minimum 60)
PIHOLE_POLL_INTERVAL=300

# Optional: alert when a device the tool has never seen joins (none | phone | email | both)
NOTIFY_NEW_DEVICES=none
