# Copy to .env and fill in. Leave a value empty to disable that feature.

# Network
# Your LAN subnet. Auto-detected from the default interface if empty, but setting it is recommended.
SUBNET=192.168.1.0/24
# Interface on the LAN (e.g. eth0, ens18, vmbr0). Auto-detected if empty.
INTERFACE=
# Seconds between scans.
SCAN_INTERVAL=60
# How many scans in a row a device can miss before it counts as offline.
# 3 x 60s = alert after ~3 minutes. Raise this if phones cause false alarms.
OFFLINE_AFTER_MISSED_SCANS=3
EVENT_RETENTION_DAYS=90
# Time zone for alert messages, e.g. America/New_York, Europe/London
TZ=UTC
# HTTPS
# self-signed (default): NetWatch creates its own certificate in /data/tls.
#   Your browser will warn the first time; install the certificate (link in the
#   dashboard header) on your devices to make the warning go away.
# custom: use your own certificate (set TLS_CERT_FILE and TLS_KEY_FILE).
# off:    plain HTTP on PORT (not recommended: the login is sent unencrypted).
TLS=self-signed
# Dashboard address: https://<host-ip>:HTTPS_PORT
HTTPS_PORT=8443
# Plain-HTTP port. Redirects to HTTPS (or serves the dashboard when TLS=off).
PORT=8080
# Extra names/IPs to put in the self-signed certificate, comma-separated
# (the host's name and LAN IP are added automatically). Example: netwatch.lan
TLS_HOSTNAMES=
# For TLS=custom: paths inside the container (mount them in docker-compose.yml)
TLS_CERT_FILE=
TLS_KEY_FILE=

# Web UI security
# Strongly recommended: the built-in admin's sign-in. It always works, and it's needed
# for accounts, API tokens and DNS details. Use a long random value, e.g.:
#   openssl rand -base64 24
WEB_USERNAME=admin
WEB_PASSWORD=
# Optional: comma-separated hostnames/IPs you use to reach the UI. Requests with any
# other Host header are rejected (protects against DNS rebinding).
# Example: ALLOWED_HOSTS=192.168.1.50,netwatch.lan
ALLOWED_HOSTS=

# Prometheus metrics at /metrics (scrape with a read-only API token). On by default.
METRICS=true
# Logs: text (default) or json (one object per line, for Loki/Vector). LOG_ACTIVITY=true
# also writes every Activity entry to the log.
LOG_FORMAT=text
LOG_ACTIVITY=false

# Push notifications for the NetWatch app: a contact address push services can use.
PUSH_CONTACT=

# Device recognition (DHCP, Bonjour/mDNS, UPnP). On by default.
DISCOVERY=true

# NetWatch's own address, added as a link to rule alerts (Alerts tab), e.g.
#   PUBLIC_URL=https://192.168.1.50:8443
PUBLIC_URL=

# Single sign-on (optional): Authentik, Keycloak, Authelia or any OpenID Connect
# provider. Needs WEB_PASSWORD above. See "Single sign-on" in the README.
# Redirect URI to register at the provider:
#   https://<netwatch-address>:8443/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Provider groups that may sign in, comma-separated. Everyone else is refused.
OIDC_ADMIN_GROUPS=
OIDC_VIEWER_GROUPS=
OIDC_BUTTON_LABEL=Sign in with SSO
# If the provider's certificate comes from your own CA, mount it and point here:
OIDC_CA_FILE=

# Phone alerts: ntfy (free app for iOS/Android; ntfy.sh or self-hosted)
# Example: https://ntfy.sh/<long-random-topic>. Anyone who knows the topic name can
# read your alerts on the public server, so make it long and random.
NTFY_URL=
NTFY_TOKEN=

# Phone alerts: Pushover (alternative or in addition to ntfy)
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# Email alerts: SMTP
# Gmail: smtp.gmail.com, 587, starttls, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated list of recipients
SMTP_TO=

# Optional: router integration
# Reads DHCP reservations, the DHCP pool and device names from your router, and
# (if allowed below) adds/removes DHCP reservations. See README > Router integration.
# ROUTER_TYPE: opnsense | pfsense | unifi | openwrt | linksys  (empty = off)
ROUTER_TYPE=
ROUTER_URL=
# OPNsense: key + secret. pfSense / UniFi: key only.
ROUTER_API_KEY=
ROUTER_API_SECRET=
# UniFi (local admin), OpenWrt (usually root), Linksys (admin password)
ROUTER_USERNAME=
ROUTER_PASSWORD=
# Set to false if the router uses a self-signed HTTPS certificate (most do)
ROUTER_VERIFY_TLS=true
# pfSense: DHCP interface. OpenWrt: interface name.
ROUTER_INTERFACE=lan
# UniFi site name
ROUTER_SITE=default
# OPNsense DHCP server: auto | dnsmasq | kea
ROUTER_DHCP=auto
# Seconds between router syncs (minimum 60)
ROUTER_POLL_INTERVAL=300
# Allow adding/removing DHCP reservations from the Reservations tab.
# Off by default. Also requires WEB_PASSWORD. A backup is saved to
# /data/router-backups before every change.
ROUTER_ALLOW_CHANGES=false

# Optional: alert when a device the tool has never seen joins (none | phone | email | both)
NOTIFY_NEW_DEVICES=none
